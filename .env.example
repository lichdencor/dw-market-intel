# =============================================================
# DW Analytics — Variables de entorno (ejemplo)
# Copiar este archivo a .env y completar con los valores reales.
# =============================================================

# PostgreSQL — VM bare metal
DB_HOST=10.10.10.10
DB_PORT=5432
DB_NAME=dw_analytics
DB_USER=etl_user
DB_PASSWORD=CAMBIAR_PASSWORD_ETL

DW_USER=dw_user
DW_PASSWORD=CAMBIAR_PASSWORD_DW

BI_USER=bi_user
BI_PASSWORD=CAMBIAR_PASSWORD_BI

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CAMBIAR_PASSWORD_MINIO

# Metabase
MB_ADMIN_EMAIL=admin@dw.local
MB_ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN
MB_OPERATOR_EMAIL=operador@dw.local
MB_OPERATOR_PASSWORD=CAMBIAR_PASSWORD_OPERADOR

# Anubis (1-10)
ANUBIS_DIFFICULTY=4

# Uptime Kuma — Push URL del monitor "Pipeline ETL"
# Completar después de crear el monitor en http://10.10.10.20:3001
UPTIME_KUMA_PUSH_URL=http://uptime-kuma:3001/api/push/YOUR_TOKEN_HERE
