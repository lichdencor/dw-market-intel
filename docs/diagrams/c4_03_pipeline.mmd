        end

        PRF -->|"genera"| P1
        PRF -->|"genera"| P2

        LOCK --> PKG
    end

    subgraph PG["PostgreSQL dw_analytics"]
        STAGE["staging.*\n(UNLOGGED)"]
        DW_SCHEMA["dw.*\nstar schema"]
        PROFILING["profiling.*\nrun_log + column_stats\n← arquitectural: persiste en BD\n← accesible desde Metabase"]
        CUBE_SCHEMA["cube.*\n← computado por DuckDB"]
    end

    M1 & M2 --> EX
    M3 --> EX
    ST --> STAGE --> DW_SCHEMA
    LD --> DW_SCHEMA
    P1 -->|"INSERT"| PROFILING
