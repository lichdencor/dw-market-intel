flowchart TD
    subgraph COL["Collector — pipeline/collector/collector.py"]
        direction TB
        C1["download_ohlcv()\nyf.download() batch · yfinance ≥1.4.1"]
        C2["download_ticker_info(cik_map)\nsec_cik incluido"]
        C3["download_insider_trading()\nSEC EDGAR Form 4\nMAX_FILINGS=500 / ticker · ASOF XML fix"]
        CU["upload_csv_append()\nAppend + dedup a MinIO\nBATCH_SIZE / TICKER_OFFSET"]
