    CU --> M1 & M2 & M3

    subgraph ETL["ETL — Package pattern"]
        direction TB

        LOCK["pg_try_advisory_lock(20260529)\naborta si otro ETL ya corre"]

        subgraph PKG["ETLPackage.run()"]
            direction LR
            EX["extract()\nleer de MinIO"] --> PRF["profile(data)"] --> ST["stage()\nquarantine inválidos\nTRUNCATE+COPY staging.*"] --> LD["load()\ndims + facts\nON CONFLICT UPSERT"]
        end

        subgraph PROFILER["profiler.py — dos salidas con roles distintos"]
            direction TB
            P1["📊 Salida ARQUITECTURAL\ncolumn_stats → profiling.column_stats\nnull_pct · distinct · min/max por columna\nqueryable desde Metabase vía dw_user"]
